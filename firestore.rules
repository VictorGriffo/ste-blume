// Regras de segurança do Firestore do projeto steblume-agenda.
// ATENÇÃO: este arquivo NÃO é aplicado sozinho. Para valer, cole o conteúdo em
// Firebase Console > Firestore Database > Regras, troque COLE_AQUI_O_UID_DA_ADMIN pelo UID
// da conta da Steffany (Authentication > Usuários > coluna "UID do usuário") e clique em Publicar.
//
// Como funciona a agenda:
//  - availability: a Steffany libera cada dia com uma lista de horários (painel "Liberar agenda").
//    Qualquer pessoa pode LER (o site mostra só o que foi liberado); só a Steffany grava.
//  - slots: marca cada horário reservado. Público para leitura (sem dado pessoal) e criado
//    pela cliente junto com a reserva, só se o horário estiver liberado.
//  - bookings: nome e telefone da cliente. Qualquer pessoa pode criar (formulário), só a Steffany lê e apaga.
// A lista de horários permitidos abaixo precisa acompanhar js/schedule-config.js.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'COLE_AQUI_O_UID_DA_ADMIN';
    }

    function allowedTimes() {
      return ['09:00', '10:00', '11:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00'];
    }

    function isAllowedTime(time) {
      return time is string && time in allowedTimes();
    }

    function isDateString(date) {
      return date is string
        && date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // Horário liberado pela Steffany para aquele dia.
    function isReleased(date, time) {
      return time in get(/databases/$(database)/documents/availability/$(date)).data.times;
    }

    function validSlot(data, id) {
      return data.keys().hasOnly(['date', 'time', 'createdAt'])
        && data.keys().hasAll(['date', 'time', 'createdAt'])
        && isDateString(data.date)
        && isAllowedTime(data.time)
        && id == data.date + '_' + data.time
        && data.createdAt == request.time
        && isReleased(data.date, data.time);
    }

    function validBooking(data, id) {
      return data.keys().hasOnly(['name', 'phone', 'notes', 'date', 'time', 'createdAt'])
        && data.keys().hasAll(['name', 'phone', 'notes', 'date', 'time', 'createdAt'])
        && data.name is string
        && data.name.trim().size() >= 2
        && data.name.size() <= 120
        && data.phone is string
        && data.phone.matches('^[0-9+() .-]{8,30}$')
        && data.notes is string
        && data.notes.size() <= 1000
        && isDateString(data.date)
        && isAllowedTime(data.time)
        && id == data.date + '_' + data.time
        && data.createdAt == request.time;
    }

    match /availability/{day} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['date', 'times', 'updatedAt'])
        && request.resource.data.keys().hasAll(['date', 'times'])
        && isDateString(request.resource.data.date)
        && day == request.resource.data.date
        && request.resource.data.times is list
        && request.resource.data.times.size() > 0
        && request.resource.data.times.size() <= 12
        && request.resource.data.times.hasOnly(allowedTimes());
      allow delete: if isAdmin();
    }

    // Reserva e horário nascem juntos (mesmo id), num único envio.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if validSlot(request.resource.data, slotId)
        && existsAfter(/databases/$(database)/documents/bookings/$(slotId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, delete: if isAdmin();
      allow create: if validBooking(request.resource.data, bookingId)
        && existsAfter(/databases/$(database)/documents/slots/$(bookingId));
      allow update: if false;
    }
  }
}
